# Copy to .env for local runs. .env is gitignored, so never put real values in this file.
# Local Google credentials come from ADC: `gcloud auth application-default login`, never key files.
CHEF_ENVIRONMENT=local
CHEF_GCP_PROJECT_ID=your-gcp-project-id

# AI proxy. In Cloud Run both come from Secret Manager.
CHEF_BERGET_API_KEY=
# The main chat system prompt is private: keep the file outside the repository.
CHEF_CHAT_PROMPT_FILE=/path/outside/the/repo/chat_system_prompt.txt

# Optional tracing to Arize Phoenix. In Cloud Run the key comes from Secret Manager.
CHEF_PHOENIX_ENDPOINT=https://app.phoenix.arize.com/s/your-space/v1/traces
CHEF_PHOENIX_API_KEY=
